APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Mercado Pago (Checkout Pro) — usar credenciales de TEST mientras se prueba.
# Access Token y Public Key: panel de MP > Tus integraciones > tu aplicación > Credenciales.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
# Secreto de firma del webhook: Tus integraciones > Webhooks > Configurar notificaciones.
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_CURRENCY=ARS
# true mientras se usan credenciales de test; false en producción.
MERCADOPAGO_SANDBOX=true
# URL pública donde MP envía las notificaciones de pago (debe ser accesible desde internet).
MERCADOPAGO_NOTIFICATION_URL="${APP_URL}/api/payments/mercadopago/webhook"
MERCADOPAGO_SUCCESS_URL="${APP_URL}/api/payments/mercadopago/return?status=success"
MERCADOPAGO_FAILURE_URL="${APP_URL}/api/payments/mercadopago/return?status=failure"
MERCADOPAGO_PENDING_URL="${APP_URL}/api/payments/mercadopago/return?status=pending"

VITE_APP_NAME="${APP_NAME}"
